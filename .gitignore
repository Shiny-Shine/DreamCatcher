# Visual Studio 2022, Visual Code user specific files
.vs/
.vscode/

# Precompiled Headers
*.gch
*.pch

# Rider / IntelliJ personal workspace
.idea/
*.DotSettings.user

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Fab asset pack
/Content/BlockingStarterPack/

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# 디자이너가 pull만 해도 C++ 클래스가 보이게,
# 프로젝트/플러그인 Win64 Editor 바이너리는 다시 추적
!Binaries/
!Binaries/Win64/**
!Plugins/**/Binaries/
!Plugins/**/Binaries/Win64/**

# ===== 선택 사항 =====
# 디버그 심볼은 용량이 커서 디자이너에게 불필요하면 다시 무시
Binaries/**/*.pdb
Plugins/**/Binaries/**/*.pdb

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Unreal's Content folder and its subfolders
/Content/ThirdPerson/Input/
/Content/ThirdPerson/Maps/
/Content/FirstPerson/
/Content/StarterContent/
/Content/TopDown/

#The specific folder inside the Content folder is included.
!Content/00_Project/**

!Content/Blueprint/